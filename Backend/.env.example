APP_ENV=development
DEBUG=true
SQL_ECHO=false

# Neon (or any Postgres) connection string — must be the asyncpg driver form
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recovery_agent

JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Generate this in Razorpay Dashboard > Settings > Webhooks when you create
# the webhook — needed to verify incoming webhook signatures.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@recoveryagent.dev

MAX_RECOVERY_ATTEMPTS=3
MIN_RETRY_INTERVAL_SECONDS=60
MAX_RECOVERY_DURATION_HOURS=24
